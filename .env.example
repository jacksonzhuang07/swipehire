# No secrets required. Optional:
# SWIPEHIRE_DB=/path/to/swipehire.db
#
# --- Launch / production ---
# SWIPEHIRE_ENV=production
# SWIPEHIRE_SECRET=long-random-string          (Flask session secret; REQUIRED in
#   production — without it a built-in DEV secret is used and a loud warning
#   is printed to stderr at startup)
#
# --- Hosted database (Turso / libSQL) ---
# When BOTH are set, the app uses the hosted libSQL database instead of the
# local SQLite file (which is ephemeral /tmp storage on Vercel).
# TURSO_DATABASE_URL=libsql://<your-db>.turso.io
# TURSO_AUTH_TOKEN=<turso auth token>
# Uploads (photos/logos/documents): when BLOB_READ_WRITE_TOKEN is set (the
# swipehire-uploads Vercel Blob store is connected to the project, which sets
# it automatically), uploads go to persistent Vercel Blob storage. Without it
# they use the local filesystem (SWIPEHIRE_UPLOADS) — ephemeral on Vercel.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
#
# Passwordless email-code sign-in delivery (first match wins):
# RESEND_API_KEY=re_...                        (send via Resend API)
# SWIPEHIRE_MAIL_FROM=login@your-domain.com    (default onboarding@resend.dev)
# SMTP_HOST=smtp.example.com                   (or SMTP instead of Resend)
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_FROM=no-reply@example.com
# SMTP_TLS=1
# With none of the above set, sign-in runs in DEMO MODE: no email is sent and
# the code is shown on the sign-in screen in a labelled demo box.
#
# CRON_SECRET=...                              (Vercel Cron auth for /api/cron/rescan)
# SWIPEHIRE_ENABLE_MUSE=1                      (try The Muse source; its public API was dead as of 2026-11-12)
