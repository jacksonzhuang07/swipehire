# No secrets required. Optional:
# SWIPEHIRE_DB=/path/to/swipehire.db
# SWIPEHIRE_SECRET=long-random-string          (Flask session secret, production)
#
# Passwordless email-code sign-in delivery (first match wins):
# RESEND_API_KEY=re_...                        (send via Resend API)
# SWIPEHIRE_MAIL_FROM=login@your-domain.com    (default onboarding@resend.dev)
# SMTP_HOST=smtp.example.com                   (or SMTP instead of Resend)
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_FROM=no-reply@example.com
# SMTP_TLS=1
# With none of the above set, sign-in runs in DEMO MODE: no email is sent and
# the code is shown on the sign-in screen in a labelled demo box.
#
# CRON_SECRET=...                              (Vercel Cron auth for /api/cron/rescan)
# SWIPEHIRE_ENABLE_MUSE=1                      (try The Muse source; its public API was dead as of 2026-11-12)
